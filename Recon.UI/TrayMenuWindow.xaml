<Window x:Class="Recon.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="IntegrationProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#26203C" CornerRadius="2"/>
                            <Border Name="PART_Track" Background="Transparent"/>
                            <Border Name="PART_Indicator" Background="#7C4DFF" CornerRadius="2"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuToggleStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C8C0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Ellipse x:Name="StatusDot" Grid.Column="1"
                                         Width="8" Height="8" Margin="10,0,0,0"
                                         VerticalAlignment="Center" Fill="#3A3555"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26203C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StatusDot" Property="Fill" Value="#66BB6A"/>
                                <Setter Property="Foreground" Value="#E1DCF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C8C0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26203C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#312B4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#1A1626"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#312D4B"
            Padding="0,5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.65" BlurRadius="22" ShadowDepth="5"/>
        </Border.Effect>

        <StackPanel Width="260">

            <!-- Header: version / uptime / db -->
            <StackPanel Margin="14,8,14,6">
                <TextBlock Text="{Binding Version}"
                           Foreground="#B39DDB" FontWeight="SemiBold"
                           FontFamily="Segoe UI" FontSize="13"/>
                <TextBlock Text="{Binding DatabaseInfo}"
                           Foreground="#554E6E" FontFamily="Segoe UI" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding UptimeStr}"
                           Foreground="#554E6E" FontFamily="Segoe UI" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Integration progress (shown only when integration is running) -->
            <Grid Margin="14,0,14,8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Progress}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center" Margin="0,0,8,0"
                             Value="{Binding IntegrationPercent}" Maximum="100"
                             Style="{StaticResource IntegrationProgressBar}"/>
                <TextBlock Grid.Column="1" Text="{Binding Progress}"
                           Foreground="#6B6280" FontFamily="Segoe UI" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Rectangle Height="1" Fill="#2A2240" Margin="8,0,8,2"/>

            <!-- Module toggles -->
            <CheckBox Content="🔄  Збір FTP"
                      IsChecked="{Binding IsFtpActive}"
                      Style="{StaticResource MenuToggleStyle}"/>
            <CheckBox Content="⚙️  Інтеграція в БД"
                      IsChecked="{Binding IsIntegrationActive}"
                      Style="{StaticResource MenuToggleStyle}"/>
            <CheckBox Content="📧  Поштова розсилка"
                      IsChecked="{Binding IsMailActive}"
                      Style="{StaticResource MenuToggleStyle}"/>
            <CheckBox Content="☁️  OneDrive синхронізація"
                      IsChecked="{Binding IsOneDriveActive}"
                      Style="{StaticResource MenuToggleStyle}"/>

            <Rectangle Height="1" Fill="#2A2240" Margin="8,2"/>

            <!-- Actions -->
            <Button Content="📢  Повідомити всіх користувачів"
                    Command="{Binding NotifyAllCommand}"
                    Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="🗄️  Повторна збірка БД"
                    Command="{Binding RebuildDatabaseCommand}"
                    Style="{StaticResource MenuButtonStyle}"/>

            <Rectangle Height="1" Fill="#2A2240" Margin="8,2"/>

            <!-- Exit -->
            <Button Content="✖  Вихід"
                    Command="{Binding ExitAppCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Foreground="#C0637A"/>

        </StackPanel>
    </Border>
</Window>
