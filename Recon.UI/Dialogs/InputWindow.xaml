<Window x:Class="Recon.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Повідомлення"
        Width="460" SizeToContent="Height"
        Icon="/Assets/Icons/icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">

    <Border CornerRadius="10"
            Background="{DynamicResource MaterialDesignPaper}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Background="{DynamicResource PrimaryHueDarkBrush}"
                    Padding="18,12,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="MessageTextOutline"
                                     Width="18" Height="18"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                                     Opacity="0.85"/>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="Повідомлення"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28"
                            VerticalAlignment="Top"
                            IsCancel="True"
                            Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                            Opacity="0.75">
                        <md:PackIcon Kind="Close" Width="15" Height="15"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,18,20,20">

                <TextBlock x:Name="PromptTextBlock"
                           Text="Введіть повідомлення для користувачів:"
                           FontSize="13"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="ResponseTextBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Текст повідомлення..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="90"
                         MaxHeight="200"
                         VerticalContentAlignment="Top"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="СКАСУВАТИ"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            md:ButtonAssist.CornerRadius="5"
                            IsCancel="True"
                            Height="36"
                            MinWidth="110"
                            Margin="0,0,10,0"/>
                    <Button Content="НАДІСЛАТИ"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="5"
                            IsDefault="True"
                            Height="36"
                            MinWidth="110"
                            Click="OkButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
