<Window x:Class="Recon.UI.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Recon Integration — Авторизація"
        Width="390" SizeToContent="Height"
        Icon="/Assets/Icons/icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">

    <Border CornerRadius="12"
            Background="{DynamicResource MaterialDesignPaper}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="28"
                              Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="{DynamicResource PrimaryHueDarkBrush}"
                    Padding="22,16,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="ShieldLock"
                                         Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                                         Opacity="0.85"/>
                            <TextBlock Text="Recon Integration"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Вхід до системи"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Margin="28,2,0,0"
                                   Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="30" Height="30"
                            VerticalAlignment="Top"
                            ToolTip="Закрити"
                            Click="CloseButton_Click"
                            Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                            Opacity="0.75">
                        <md:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form body -->
            <StackPanel Grid.Row="1" Margin="24,22,24,26">

                <!-- Config file -->
                <ComboBox x:Name="ConfigComboBox"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Файл конфігурації (.conf)"
                          md:TextFieldAssist.HasLeadingIcon="True"
                          md:TextFieldAssist.LeadingIcon="FileSettingsOutline"/>

                <Separator Margin="0,18,0,2"
                           Background="{DynamicResource MaterialDesignDivider}"
                           Opacity="0.25"/>

                <!-- Login -->
                <TextBox x:Name="LoginBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Логін"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="AccountOutline"
                         Margin="0,10,0,0"/>

                <!-- Password (hidden) -->
                <PasswordBox x:Name="HiddenPasswordBox"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             md:HintAssist.Hint="Пароль"
                             md:TextFieldAssist.HasLeadingIcon="True"
                             md:TextFieldAssist.LeadingIcon="LockOutline"
                             Margin="0,12,0,0"/>

                <!-- Password (visible) -->
                <TextBox x:Name="VisiblePasswordBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Пароль"
                         md:TextFieldAssist.HasLeadingIcon="True"
                         md:TextFieldAssist.LeadingIcon="LockOpenOutline"
                         Visibility="Collapsed"
                         Margin="0,12,0,0"/>

                <!-- Checkboxes -->
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox x:Name="ShowPasswordCheck"
                              Content="Показати пароль"
                              Style="{StaticResource MaterialDesignCheckBox}"
                              Click="ShowPasswordCheck_OnClick"
                              Margin="0,0,20,0"/>
                    <CheckBox x:Name="SaveParamsToRegistryCheck"
                              Content="Запам'ятати"
                              Style="{StaticResource MaterialDesignCheckBox}"/>
                </WrapPanel>

                <!-- Login button -->
                <Button Content="УВІЙТИ"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="6"
                        Height="42"
                        FontSize="13"
                        FontWeight="Bold"
                        Margin="0,20,0,0"
                        IsDefault="True"
                        Click="LoginButton_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
